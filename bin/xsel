#!/bin/sh
me=xsel
dev=/dev/clipboard
nl='
'
usage() {
  printf 'usage: %s [-b | -p | -s] [-i | -o | -c] [-n]\n' "$me"
}
bad() {
  printf '%s: %s\n' "$me" "$1" >&2
  usage >&2
  exit 2
}
fail() {
  msg=${1##*"$nl"}
  msg=${msg#cat: }
  case $msg in
    "write error: "*) msg=${msg#write error: } ;;
    *"$dev: "*) msg=${msg##*"$dev: "} ;;
  esac
  printf '%s: %s\n' "$me" "${msg:-clipboard error}" >&2
  if [ "$msg" = "Permission denied" ]; then
    printf "%s: the clipboard needs seven's tab in front, with clipboard access allowed\n" "$me" >&2
  fi
  exit 1
}
need() {
  if [ ! -c "$dev" ]; then
    printf '%s: %s not available (needs slicc-kernel >= 1.75.0)\n' "$me" "$dev" >&2
    exit 1
  fi
}
copy() {
  err=$(cat 2>&1 >"$dev") || fail "$err"
}
mode=
for arg; do
  case $arg in
    -b | --clipboard | -p | --primary | -s | --secondary | -n | --nodetach) ;;
    -i | --input) mode=in ;;
    -o | --output) mode=out ;;
    -c | --clear) mode=clear ;;
    -h | --help)
      usage
      exit 0
      ;;
    -?*) bad "unknown option: $arg" ;;
    *) bad "unexpected argument: $arg" ;;
  esac
done
need
if [ -z "$mode" ]; then
  if [ -t 0 ]; then
    mode=out
  else
    mode=in
  fi
fi
case $mode in
  in) copy ;;
  clear) copy < /dev/null ;;
  *) { err=$(cat -- "$dev" 2>&1 >&3); } 3>&1 || fail "$err" ;;
esac
