#!/bin/sh
me=wl-copy
dev=${SLICC_CLIPBOARD_TEST_DEVICE:-/dev/clipboard}
nl='
'
usage() {
  printf 'usage: %s [-n] [-c] [text ...]\n' "$me"
}
bad() {
  printf '%s: %s\n' "$me" "$1" >&2
  usage >&2
  exit 2
}
fail() {
  msg=${1##*"$nl"}
  msg=${msg#cat: }
  case $msg in
    "write error: "*) msg=${msg#write error: } ;;
    *"$dev: "*) msg=${msg##*"$dev: "} ;;
  esac
  printf '%s: %s\n' "$me" "${msg:-clipboard error}" >&2
  exit 1
}
copy() {
  err=$(cat 2>&1 >"$dev") || fail "$err"
}
trim=
clear=
rest=
n=$#
while [ "$n" -gt 0 ]; do
  arg=$1
  shift
  n=$((n - 1))
  if [ -n "$rest" ]; then
    set -- "$@" "$arg"
    continue
  fi
  case $arg in
    -n | --trim-newline) trim=1 ;;
    -c | --clear) clear=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    --) rest=1 ;;
    -?*) bad "unknown option: $arg" ;;
    *) set -- "$@" "$arg" ;;
  esac
done
if [ -n "$clear" ]; then
  copy < /dev/null
  exit 0
fi
if [ "$#" -gt 0 ]; then
  data="$*"
else
  data=$(cat 2>&1 && printf x) || fail "$data"
  data=${data%x}
fi
if [ -n "$trim" ]; then
  data=${data%"$nl"}
fi
printf '%s' "$data" | copy || exit 1
