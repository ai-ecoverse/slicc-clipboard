#!/bin/sh
me=xclip
dev=${SLICC_CLIPBOARD_TEST_DEVICE:-/dev/clipboard}
nl='
'
usage() {
  printf 'usage: %s [-i | -o] [-selection primary|secondary|clipboard] [-rmlastnl] [file ...]\n' "$me"
}
bad() {
  printf '%s: %s\n' "$me" "$1" >&2
  usage >&2
  exit 2
}
fail() {
  msg=${1##*"$nl"}
  msg=${msg#cat: }
  case $msg in
    "write error: "*) msg=${msg#write error: } ;;
    *"$dev: "*) msg=${msg##*"$dev: "} ;;
  esac
  printf '%s: %s\n' "$me" "${msg:-clipboard error}" >&2
  exit 1
}
copy() {
  err=$(cat 2>&1 >"$dev") || fail "$err"
}
mode=
trim=
n=$#
while [ "$n" -gt 0 ]; do
  arg=$1
  shift
  n=$((n - 1))
  case $arg in
    -i | -in) mode=in ;;
    -o | -out) mode=out ;;
    -se | -sel | -sele | -selec | -select | -selecti | -selectio | -selection)
      [ "$n" -gt 0 ] || bad "option $arg needs a value"
      sel=$1
      shift
      n=$((n - 1))
      case $sel in
        '' | *' '*) bad "unknown selection: $sel" ;;
      esac
      words=' clipboard primary secondary'
      case $words in
        *" $sel"*) ;;
        *) bad "unknown selection: $sel" ;;
      esac
      ;;
    -r | -rm | -rml | -rmla | -rmlas | -rmlast | -rmlastn | -rmlastnl) trim=1 ;;
    -h | -help)
      usage
      exit 0
      ;;
    -?*) bad "unknown option: $arg" ;;
    *) set -- "$@" "$arg" ;;
  esac
done
if [ -z "$mode" ]; then
  if [ -t 0 ]; then
    mode=out
  else
    mode=in
  fi
fi
if [ "$mode" = out ]; then
  if [ -z "$trim" ]; then
    { err=$(cat -- "$dev" 2>&1 >&3); } 3>&1 || fail "$err"
    exit 0
  fi
  data=$(cat -- "$dev" 2>&1 && printf x) || fail "$data"
  data=${data%x}
  printf '%s' "${data%"$nl"}"
  exit 0
fi
data=$(cat -- "$@" 2>&1 && printf x) || fail "$data"
data=${data%x}
if [ -n "$trim" ]; then
  data=${data%"$nl"}
fi
printf '%s' "$data" | copy || exit 1
